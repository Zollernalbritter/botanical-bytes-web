# --- AWS SES (Newsletter-Versand + Kontaktliste) ---------------------------
# IAM-Nutzer mit ses:SendEmail und den Contact-List-Rechten (siehe README).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# Absender — die Domain muss in SES verifiziert sein. Fuer den Newsletter ist
# botanicalbytes.tflit.com als eigene SES-Identitaet verifiziert; das haelt die
# Zustell-Reputation getrennt von der Google-Workspace-Mail auf tflit.com.
AWS_SES_FROM_EMAIL=newsletter@botanicalbytes.tflit.com
AWS_SES_FROM_NAME="Botanical Bytes"

# Optional: Name der SES-Kontaktliste. Ohne Angabe "botanical-bytes"; die Liste
# wird beim ersten Abonnenten automatisch angelegt.
# SES_CONTACT_LIST=botanical-bytes

# --- Newsletter ------------------------------------------------------------
# Mind. 32 zufällige Zeichen — signiert die Double-Opt-in-Links.
# Erzeugen z. B. mit: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
NEWSLETTER_SECRET=

# Öffentliche Basis-URL der Website (ohne Slash am Ende).
# Wird auch beim Build gebraucht: sitemap.xml, robots.txt und metadataBase
# werden vorgerendert.
SITE_URL=https://botanicalbytes.tflit.com
