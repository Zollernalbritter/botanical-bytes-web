# Resend API-Key (resend.com → API Keys)
RESEND_API_KEY=

# Mind. 32 zufällige Zeichen — signiert die Double-Opt-in-Links.
# Erzeugen z. B. mit: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
NEWSLETTER_SECRET=

# Öffentliche Basis-URL der Website (ohne Slash am Ende)
SITE_URL=https://botanical-bytes-web.vercel.app

# Absender — erst nach Domain-Verifizierung bei Resend änderbar.
# Bis dahin funktioniert nur der Onboarding-Absender (Zustellung nur an die eigene Account-Adresse).
NEWSLETTER_FROM="Botanical Bytes <onboarding@resend.dev>"
